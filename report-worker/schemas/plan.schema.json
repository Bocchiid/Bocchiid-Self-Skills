{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "report-worker/plan.schema.json",
  "title": "report-worker executable plan",
  "type": "object",
  "required": ["version", "purposes", "stages", "steps", "evidence"],
  "properties": {
    "version": {"type": "string", "minLength": 1},
    "purposes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "text", "steps", "evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^P[0-9]+$"},
          "text": {"type": "string", "minLength": 1},
          "steps": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "evidence": {"type": "array", "items": {"type": "string"}, "minItems": 1}
        }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "steps"],
        "properties": {
          "id": {"type": "string", "pattern": "^ST[0-9]+$"},
          "name": {"type": "string", "minLength": 1},
          "steps": {"type": "array", "items": {"type": "string"}, "minItems": 1}
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "stage", "goal", "action", "acceptance", "evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^S[0-9]+$"},
          "stage": {"type": "string"},
          "goal": {"type": "string", "minLength": 1},
          "action": {
            "type": "object",
            "required": ["kind"],
            "properties": {
              "kind": {"enum": ["command", "gui", "file_edit", "manual", "analysis"]},
              "commands": {"type": "array", "items": {"type": "string"}},
              "app": {"type": "string"},
              "window": {"type": "string"},
              "control": {"type": "string"},
              "instruction": {"type": "string"},
              "env_vars": {"type": "array", "items": {"type": "string"},
                           "description": "temporary KEY=VALUE for this step only"},
              "env_file": {"type": "string",
                           "description": "task-local KEY=VALUE file for this step"},
              "use_venv": {"type": "boolean",
                           "description": "use <workspace>/.venv if present"}
            }
          },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["type"],
              "properties": {
                "type": {
                  "enum": ["exit_code", "stdout_regex", "stderr_regex",
                           "file_exists", "file_contains", "json_field",
                           "visual", "manual"]
                },
                "value": {},
                "pattern": {"type": "string"},
                "path": {"type": "string"},
                "field": {"type": "string"},
                "description": {"type": "string"}
              }
            }
          },
          "evidence": {"type": "array", "items": {"type": "string"}},
          "reproduce": {"type": "string"},
          "failure": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "symptom": {"type": "string"},
                "check": {"type": "string"},
                "fallback": {"type": "string"}
              }
            }
          },
          "irreversible": {"type": "boolean"},
          "requires_user": {"type": "boolean"}
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "step", "type", "level"],
        "properties": {
          "id": {"type": "string", "pattern": "^E[0-9]+$"},
          "step": {"type": "string"},
          "type": {"type": "string"},
          "level": {"enum": ["L1", "L2", "L3"]},
          "must_include": {"type": "array", "items": {"type": "string"}},
          "filename": {"type": "string"}
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "requirement", "decision"],
        "properties": {
          "id": {"type": "string"},
          "requirement": {"type": "string"},
          "template_slot": {"type": "string"},
          "decision": {"enum": ["skip", "keep", "pending"]},
          "reason": {"type": "string"},
          "location": {"type": "string"}
        }
      }
    },
    "report_map": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "section": {"type": "string"},
          "use": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "writer_figures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {"type": "string"},
          "type": {"type": "string"},
          "basis": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
